# LAN exam hosting — copy to .env.lan and set your machine's WiFi IP.
# Run: node scripts/lan.mjs --detect
# Or:  node scripts/lan.mjs 192.168.1.100

# Your PC's LAN IP (students open http://LAN_HOST:3000 in dev, http://LAN_HOST in Docker)
LAN_HOST=192.168.1.100

# Bind all interfaces so other devices on WiFi can connect
HOST=0.0.0.0

# Dev frontend port (Docker uses nginx on port 80 instead)
PORT=3000
BASE_PATH=/

# Same-origin API — Vite (dev) or nginx (Docker) proxies /api to the backend.
# Do NOT use localhost here; other devices cannot reach your localhost.
VITE_API_URL=/api

# API server
API_PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/app
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
CORS_ORIGIN=*
LOG_LEVEL=info
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=60000
